{
  "name": "ZiyOfficialBayle",
  "version": "8.0.7",
  "description": "Websocket Whatsapp API for Node.js",
  "keywords": [
    "whatsapp",
    "websocket",
    "api",
    "nodejs",
    "baileys",
    "wabot",
    "proto",
    "whatsapp-websocket"
  ],
  "homepage": "https://github.com/ziy-offc/bailey",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziy-offc/bailey.git"
  },
  "license": "MIT",
  "author": "ZiyOfficial",
  "main": "./lib/index.js",
  "files": [
    "lib/*",
    "WAProto/*"
  ],
  "scripts": {
    "start": "node index.js",
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "changelog:preview": "conventional-changelog -p angular -u",
    "changelog:last": "conventional-changelog -p angular -r 2",
    "gen:protobuf": "sh WAProto/GenerateStatics.sh",
    "example": "node --inspect Example/example.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "yarn lint --fix",
    "release": "release-it",
    "test": "jest"
  },
  "dependencies": {
    "@whiskeysockets/eslint-config": "https://github.com/whiskeysockets/eslint-config.git",
    "@cacheable/node-cache": "latest",
    "gradient-string": "2.0.2",
    "libsignal-xeuka": "https://github.com/ziy-offc/libs.git",
    "moment-timezone": "latest",
    "music-metadata": "latest",
    "cache-manager": "latest",
    "async-mutex": "latest",
    "@hapi/boom": "latest",
    "pbjs": "^0.0.14",
    "protobufjs": "latest",
    "lru-cache": "latest",
    "readline": "latest",
    "p-queue": "latest",
    "lodash": "latest",
    "figlet": "latest",
    "axios": "latest",
    "path": "latest",
    "pino": "latest",
    "ws": "latest",
    "fs": "latest",
    "os": "latest"
  },
  "devDependencies": {
    "conventional-changelog-cli": "latest",
    "link-preview-js": "latest",
    "protobufjs-cli": "latest",
    "cache-manager": "latest",
    "@types/jest": "latest",
    "@types/node": "latest",
    "release-it": "latest",
    "@types/ws": "latest",
    "eslint": "latest",
    "jest": "latest",
    "json": "latest",
    "open": "latest"
  },
  "peerDependencies": {
    "link-preview-js": "latest",
    "audio-decode": "latest",
    "jimp": ">=0.16.0"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=20.0.0"
  },
  "directories": {
    "lib": "lib"
  },
  "bugs": {
    "url": "https://github.com/ziy-offc/bailey/issues"
  }
}
